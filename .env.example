# Copy to .env, edit locally, then export using your shell. Never commit .env.
BITAUTO_LARK_PROFILE=your-own-cli-profile
BITAUTO_BASE_TOKEN=
BITAUTO_TABLE_STATIONS=
BITAUTO_TABLE_SERIES=
BITAUTO_TABLE_TRIMS=
# Supply signing material only if you are authorized to use the source API.
BITAUTO_SIGNING_SECRET=
# Defaults to .data under this repository. Keep raw responses outside Git.
BITAUTO_DATA_DIR=
